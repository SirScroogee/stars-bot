# Telegram Bot
BOT_TOKEN=your_bot_token_here
DATABASE_URL=postgresql+asyncpg://stars_user:stars_password@localhost:5432/stars_bot

# Fragment / TON (optional if using DB accounts via admin panel)
# TONAPI_KEY=your_tonapi_key
# MNEMONIC=word1 word2 ... word24
# FRAGMENT_HASH=your_fragment_hash
# STEL_SSID=your_stel_ssid
# STEL_TOKEN=your_stel_token
# STEL_TON_TOKEN=your_stel_ton_token

# Redis (optional - for production queue persistence)
# REDIS_URL=redis://localhost:6379/0

# Security (REQUIRED - for encrypting sensitive data in DB)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# Optional
# ADMIN_IDS=123456789,987654321
# DEBUG=false
